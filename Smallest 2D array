public class Smallest {
    public static void main(String[] args) {
        int[][] a = {{1, 8, 3}, {4, 5, 9}, {7, 2, 6}};
        int smallest = a[0][0];
        for (int i = 0; i < a.length; i++)
            for (int j = 0; j < a[i].length; j++)
                if (a[i][j] < smallest) smallest = a[i][j];
        System.out.println("Smallest = " + smallest);
    }
}
