import java.util.Scanner;

class SmallestOf3 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter three numbers: ");
        int a = sc.nextInt();
        int b = sc.nextInt();
        int c = sc.nextInt();

        int smallest;

        if (a < b && a < c) {
            smallest = a;
        } else if (b < c) {
            smallest = b;
        } else {
            smallest = c;
        }

        System.out.println("Smallest = " + smallest);
    }
}
