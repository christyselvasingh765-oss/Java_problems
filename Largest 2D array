public class Largest {
    public static void main(String[] args) {
        int[][] a = {{1, 8, 3}, {4, 5, 9}, {7, 2, 6}};
        int largest = a[0][0];
        for (int i = 0; i < a.length; i++)
            for (int j = 0; j < a[i].length; j++)
                if (a[i][j] > largest) largest = a[i][j];
        System.out.println("Largest = " + largest);
    }
}
