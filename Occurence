import java.util.Scanner;

class DigitOccurrence {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int search = sc.nextInt();
        int count = 0;

        while (n > 0) {
            int digit = n % 10;

            if (digit == search)
                count++;

            n /= 10;
        }

        System.out.println("Occurrence = " + count);
    }
}
